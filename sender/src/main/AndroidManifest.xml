<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signaling WebSocket and WebRTC media to the TV. While targetSdk < 37, INTERNET
         also implicitly grants local-network access (Android 17 local network
         protection). NSD discovery needs no extra permission. See ARCHITECTURE.md §2. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WebRTC's network monitor reads network state to pick interfaces. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Screen capture runs in a foreground service of type mediaProjection (Android 14+ rules, §6.1). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+: lets the "mirroring" notification (with its Stop button) show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MirrorSenderApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MirrorSender">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
